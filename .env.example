# LifeDesk Environment Configuration

# Application
APP_NAME=LifeDesk
APP_ENV=development
DEBUG=True
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL URL; defaults to local sqlite:///./lifedesk.db if not provided or postgres is unreachable)
DATABASE_URL=postgresql://lifedesk_user:lifedesk_secure_password@localhost:5432/lifedesk_db

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Configuration (Gemini / OpenAI / Anthropic)
# Default is 'gemini'. If AI_API_KEY is blank, an academic local fallback engine is utilized.
AI_PROVIDER=gemini
AI_API_KEY=

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15
